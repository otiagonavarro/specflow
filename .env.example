# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─── Jira Integration (Express proxy: npm run server) ───────────────────────
# Used by the server from process.env. You can edit this file directly or use
# Settings → Integrations (the app merges these keys into .env).
JIRA_DOMAIN="https://yourcompany.atlassian.net"
JIRA_EMAIL="your@email.com"
JIRA_API_TOKEN="your_jira_api_token"
# If set, Epics, Issues, and the Projects board list are scoped to this Jira project key only
# (e.g. AN). Leave empty to show all projects your user can access.
JIRA_PROJECT_KEY="PROJ"
JIRA_BOARD_ID=""

# ─── Local workspace (same proxy) ───────────────────────────────────────────
# Absolute path on the machine running `npm run server` where cloned repositories
# live as direct subfolders (Settings → Integrações → Repositórios locais).
# Used to map Jira epics/tasks/subtasks to local repo folders.
LOCAL_REPOS_ROOT=""

# Optional: absolute path to the OpenSpec CLI binary if you do not want the server
# to invoke `npx @fission-ai/openspec` on each run (faster, works offline after install).
# OPENSPEC_CLI_PATH="/usr/local/bin/openspec"

# ─── Server port (optional, default 58471 — high range, avoids 3000/5173 stacks) ─
SERVER_PORT=58471

# ─── UI dev port (optional, default 58470) ─────────────────────────────────────
# Used by `npm run dev` and `npm run init`. If busy, init picks the next free port (never SERVER_PORT).
# VITE_PORT=58470
